{
    "edit_predictions": {
        "ollama": {
            "max_output_tokens": 64,
            "model": "qwen2.5-coder:7b-base",
        },
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Zed (Default)",
        "dark": "Soft Charmed Icons",
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "vim_mode": true,
    "theme": {
        "mode": "dark",
        "light": "Catppuccin Latte",
        "dark": "Catppuccin Mocha",
    },
    "theme_overrides": {
        "Catppuccin Mocha": {
            "border.variant": "#15141c",
            "border": "#15141c",
            "pane.focused_border": "#15141C",
        },
    },
    "title_bar": {
        "show_branch_icon": false,
        "show_sign_in": false,
        "show_menus": false,
        "show_onboarding_banner": false,
    },
    "tab_bar": {
        "show": false,
    },
    "toolbar": {
        "quick_actions": false,
    },
    "status_bar": {
        "experimental.show": false,
    },
    "project_panel": {
        "hide_root": true,
        "auto_fold_dirs": false,
        "starts_open": false,
        "scrollbar": {
            "show": "never",
        },
    },
    "scrollbar": {
        "show": "never",
    },
    "gutter": {
        "min_line_number_digits": 0,
        "folds": false,
        "runnables": false,
    },
    "ui_font_family": "CaskaydiaMono Nerd Font",
    "ui_font_size": 18,
    "buffer_font_family": "Ubuntu Mono Ligaturized",
    "buffer_font_size": 20,
    "tab_size": 4,
    "auto_indent_on_paste": false,
    "show_completions_on_input": false,
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "auto_update": false,
    "horizontal_scroll_margin": 10,
    "vertical_scroll_margin": 8,
    "when_closing_with_no_tabs": "keep_window_open",
    "close_on_file_delete": true,
    "restore_on_file_reopen": true,
}
