# kanshi — declarative output management for sway
# Replaces the old script-monitor-display / script-monitors-pick / script-monitors-parse trio.
# Docs: https://gitlab.freedesktop.org/emersion/kanshi
#
# kanshi auto-applies the first profile whose outputs match what's connected.
# Reload at runtime: `kanshictl reload`

# Default: enable every connected output at its preferred mode, side by side.
profile {
    output "*" enable mode preferred position auto
}

# --- Laptop docked to one external HDMI (laptop lid closed / internal off) ---
# Adjust names via `swaymsg -t get_outputs` if yours differ.
#
