# -----------------------------------------------------
# Applications
# -----------------------------------------------------
bindsym $mod+b exec $browser
bindsym $mod+Return exec $terminal
bindsym $mod+g exec steam

# Floating Terminal Apps (alacritty-only; ghostty dropped)
bindsym $mod+e exec $terminal --class=com.x.FloatingWindow -e yazi
bindsym $mod+t exec $terminal --class=com.x.FloatingWindow -e btop
bindsym $mod+z exec $terminal --class=com.x.FloatingWindow -e impala
bindsym $mod+x exec $terminal --class=com.x.FloatingWindow -e wiremix
bindsym $mod+c exec $terminal --class=com.x.FloatingWindow -e bluetui
bindsym $mod+Shift+c exec $terminal --class=com.x.FloatingWindow -e calcure
bindsym $mod+grave exec $terminal --class=com.x.FloatingWindow -e ~/.dots/bin/script-manage
bindsym $mod+p exec $terminal --class=com.x.FloatingWindow -e ~/.dots/bin/script-wallpaper
bindsym $mod+d exec bash -c '$podman_as_docker $terminal --class=FloatingWindow -e lazydocker'

# Web Apps & Tools
bindsym $mod+a exec $webapp="https://chatgpt.com"
bindsym $mod+Shift+a exec $webapp="https://gemini.google.com/u/0/app"
# Antigravity is opt-in (--antigravity flag). Bind only if installed:
# bindsym $mod+Mod1+a exec $HOME/Downloads/antigravity/Antigravity/antigravity

# -----------------------------------------------------
# System & Aesthetics
# -----------------------------------------------------
bindsym $mod+space exec fuzzel --lines 5
bindsym $mod+Shift+space exec pkill -SIGUSR1 waybar
bindsym $mod+Escape exec ~/.dots/bin/script-power
bindsym $mod+n exec ~/.dots/bin/script-toggle-sunset
bindsym $mod+Shift+n exec ~/.dots/bin/script-toggle-theme

# Scripts & Info
bindsym $mod+Control+i exec ~/.dots/bin/script-toggle-idle
bindsym $mod+i exec $terminal --class=com.x.FloatingWindow -o font.size=24 -e ~/.dots/bin/script-info
bindsym $mod+Shift+p exec ~/.dots/bin/script-show-keybindings
bindsym $mod+v exec "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"

# Notifications (Mako)
bindsym $mod+comma exec makoctl dismiss
bindsym $mod+Shift+comma exec makoctl dismiss --all
bindsym $mod+Control+comma exec "makoctl mode -t do-not-disturb && (makoctl mode | grep -q 'do-not-disturb' && notify-send 'Silenced notifications' || notify-send 'Enabled notifications')"

# -----------------------------------------------------
# Media & Hardware
# -----------------------------------------------------

# Volume & Mic — wpctl via ~/.dots/bin/script-audio (mako feedback).
# Sway's `bindsym --release` fires on key release. Combine with the
# plain `bind =` (press) and the hold script to get
# press = start the 20Hz ramp, release = stop it. Mute keys stay
# on toggle-on-press (which is what `bind =` does by default).
bindsym XF86AudioRaiseVolume        exec ~/.dots/bin/script-audio-hold up   start
bindsym --release XF86AudioRaiseVolume exec ~/.dots/bin/script-audio-hold up   stop
bindsym XF86AudioLowerVolume        exec ~/.dots/bin/script-audio-hold down start
bindsym --release XF86AudioLowerVolume exec ~/.dots/bin/script-audio-hold down stop
bindsym XF86AudioMute       exec ~/.dots/bin/script-audio mute
bindsym XF86AudioMicMute    exec ~/.dots/bin/script-audio mic

# Brightness — brightnessctl via ~/.dots/bin/script-brightness (mako feedback)
bindsym XF86MonBrightnessUp   exec ~/.dots/bin/script-brightness up
bindsym XF86MonBrightnessDown exec ~/.dots/bin/script-brightness down

# Player Controls — playerctl via ~/.dots/bin/script-media (mako feedback)
bindsym XF86AudioNext  exec ~/.dots/bin/script-media next
bindsym XF86AudioPrev  exec ~/.dots/bin/script-media prev
bindsym XF86AudioPlay  exec ~/.dots/bin/script-media toggle
bindsym XF86AudioPause exec ~/.dots/bin/script-media toggle

# Keyboard Layout — see ~/.dots/bin/script-notify-layout
bindsym Mod1+Shift_L exec ~/.dots/bin/script-notify-layout

# -----------------------------------------------------
# Screenshots — see ~/.dots/bin/script-screenshot
# Absolute path because sway's exec PATH does not include ~/.dots/bin
# (TTY autologin → exec sway inherits getty's minimal env).
# -----------------------------------------------------
# Region selection → save to ~/Pictures/screenshots + copy to clipboard
bindsym $mod+s        exec ~/.dots/bin/script-screenshot region
# Region selection → swappy annotate → save + clipboard
bindsym $mod+Shift+s  exec ~/.dots/bin/script-screenshot annotate

# -----------------------------------------------------
# Window Management & Tiling
# -----------------------------------------------------
bindsym $mod+w kill
bindsym $mod+f floating toggle
bindsym $mod+o split toggle

# Focus Movement
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

# Swap Windows
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

# Tab / Workspace Cycling (sway-native; no helper script)
bindsym Mod1+Tab focus next
# bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym $mod+button4 workspace next_on_output
bindsym $mod+button5 workspace prev_on_output
bindsym $mod+slash workspace back_and_forth

# -----------------------------------------------------
# Workspaces
# -----------------------------------------------------

# Switch Workspaces
bindsym $mod+1 workspace number 1, exec ~/.dots/bin/script-notify-workspace switch 1
bindsym $mod+2 workspace number 2, exec ~/.dots/bin/script-notify-workspace switch 2
bindsym $mod+3 workspace number 3, exec ~/.dots/bin/script-notify-workspace switch 3
bindsym $mod+4 workspace number 4, exec ~/.dots/bin/script-notify-workspace switch 4
bindsym $mod+5 workspace number 5, exec ~/.dots/bin/script-notify-workspace switch 5
bindsym $mod+6 workspace number 6, exec ~/.dots/bin/script-notify-workspace switch 6
bindsym $mod+7 workspace number 7, exec ~/.dots/bin/script-notify-workspace switch 7
bindsym $mod+8 workspace number 8, exec ~/.dots/bin/script-notify-workspace switch 8
bindsym $mod+9 workspace number 9, exec ~/.dots/bin/script-notify-workspace switch 9
bindsym $mod+0 workspace number 10, exec ~/.dots/bin/script-notify-workspace switch 10

# Move Window to Workspace
bindsym $mod+Shift+1 move container to workspace number 1, exec ~/.dots/bin/script-notify-workspace move 1
bindsym $mod+Shift+2 move container to workspace number 2, exec ~/.dots/bin/script-notify-workspace move 2
bindsym $mod+Shift+3 move container to workspace number 3, exec ~/.dots/bin/script-notify-workspace move 3
bindsym $mod+Shift+4 move container to workspace number 4, exec ~/.dots/bin/script-notify-workspace move 4
bindsym $mod+Shift+5 move container to workspace number 5, exec ~/.dots/bin/script-notify-workspace move 5
bindsym $mod+Shift+6 move container to workspace number 6, exec ~/.dots/bin/script-notify-workspace move 6
bindsym $mod+Shift+7 move container to workspace number 7, exec ~/.dots/bin/script-notify-workspace move 7
bindsym $mod+Shift+8 move container to workspace number 8, exec ~/.dots/bin/script-notify-workspace move 8
bindsym $mod+Shift+9 move container to workspace number 9, exec ~/.dots/bin/script-notify-workspace move 9
bindsym $mod+Shift+0 move container to workspace number 10, exec ~/.dots/bin/script-notify-workspace move 10

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
floating_modifier $mod normal

# -----------------------------------------------------
# Submap: MOVE_RESIZE
# -----------------------------------------------------
bindsym $mod+r mode "MOVE_RESIZE"

mode "MOVE_RESIZE" {
    bindsym f fullscreen toggle
    
    # Move
    bindsym h move left 20 px
    bindsym l move right 20 px
    bindsym k move up 20 px
    bindsym j move down 20 px

    # Resize (SHIFT)
    bindsym Shift+h resize shrink width 20 px
    bindsym Shift+l resize grow width 20 px
    bindsym Shift+k resize shrink height 20 px
    bindsym Shift+j resize grow height 20 px

    # Exit Mode
    bindsym Escape mode "default"
}

