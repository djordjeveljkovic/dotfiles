# -----------------------------------------------------
# Autostart
# -----------------------------------------------------
# Export session env so systemd user services and xdg-desktop-portal work
exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

exec --no-startup-id autotiling
exec --no-startup-id kanshi >/dev/null 2>&1
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 330 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 000000' &
# Single mako handles both top-right (default) and bottom-center
# (when the caller sets the x-dots-position D-Bus hint). The
# custom mako at ~/.local/bin/mako supports per-notification
# positions; the system /usr/bin/mako is the upstream build
# which silently ignores the hint. We invoke the local copy
# by full path so the autostart works regardless of PATH.
exec /home/usrtmp/.local/bin/mako &
# Background: sway-native via `output * bg` (built-in since Sway 1.7).
# No external swaybg daemon — avoids the double-render fight that happens
# after `swaymsg reload` if both are active.
exec --no-startup-id swaymsg "output * bg fill ~/.dots/assets/background"

exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
