# -----------------------------------------------------
# Autostart
# -----------------------------------------------------
# Export session env so systemd user services and xdg-desktop-portal work
exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

exec --no-startup-id autotiling
exec --no-startup-id kanshi >/dev/null 2>&1
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 330 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 000000' &
# Bring up the secondary D-Bus session bus used by the bottom mako.
exec --no-startup-id ~/.dots/bin/dots-session-buses
# Top-right mako: receives normal notify-send calls (default D-Bus bus).
exec mako &
# Bottom-center mako: receives system-info OSDs routed through
# dots-system-notify (secondary D-Bus bus started above).
exec env DBUS_SESSION_BUS_ADDRESS="$(cat ~/.config/dots/bus-bottom)" mako -c ~/.dots/config/mako/config-bottom
# Background: sway-native via `output * bg` (built-in since Sway 1.7).
# No external swaybg daemon — avoids the double-render fight that happens
# after `swaymsg reload` if both are active.
exec --no-startup-id swaymsg "output * bg fill ~/.dots/assets/background"

exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
