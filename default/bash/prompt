# Technicolor dreams
force_color_prompt=yes
color_prompt=yes

# Get the SSH connection IP or hostname
get_ssh_info() {
  if [ -n "$SSH_CLIENT" ]; then
    echo "$(hostnamectl | rg hostname | awk '{print $3}')"
  fi

}

# Function to get current git branch with staged/changed files and behind info
git_branch() {
  # Check if we are inside a git repo
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    # Get current branch name
    branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)

    if [ -n "$branch" ]; then
      # Count staged files
      staged=$(git diff --cached --name-only | wc -l)
      
      # Count changed (unstaged) files
      changed=$(git diff --name-only | wc -l)
      
      # Count commits behind remote
      behind=0
      if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        behind=$(git rev-list --count HEAD..origin/"$branch" 2>/dev/null)
      fi

      # Build the output
      output=" $branch"
      [ "$staged" -gt 0 ] && output+=" +$staged"
      [ "$changed" -gt 0 ] && output+=" ~$changed"
      [ "$behind" -gt 0 ] && output+=" ↓$behind"

      echo "$output"
    fi
  fi
}
# Simple prompt with path in the window/pane title and caret for typing line
PS1=$'\uf0a9 '
PS1='\[\e]0;\w\a\]\w $(git_branch) $(get_ssh_info)\n\[\e[0;37m\]\[\e[0m\]'
