# Technicolor dreams
force_color_prompt=yes
color_prompt=yes

# Get the SSH connection IP or hostname
get_ssh_info() {
  if [ -n "$SSH_CLIENT" ]; then
    # Get remote user, remote IP, and client IP
    remote_user=$(whoami)                             # Remote user (SSH client)
    remote_ip=$(echo $SSH_CONNECTION | awk '{print $1}')  # Remote IP (from SSH_CONNECTION)
    
    # Use uname or hostnamectl if hostname isn't available
    if command -v hostnamectl >/dev/null; then
      client_ip=$(hostnamectl | grep "Static address" | awk '{print $3}')  # Local IP via hostnamectl
    elif command -v uname >/dev/null; then
      client_ip=$(uname -n)                            # Local hostname with uname
    else
      client_ip=$(hostname -I | awk '{print $1}')      # Default method to get local IP
    fi
    
    # Show the SSH connection details
    echo "ssh $remote_user@$remote_ip -c client@$client_ip"
  fi

}

# Function to get current git branch name (if inside a git repo)
git_branch() {
  # Check if we are inside a git repo
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    # Get the branch name
    branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
    if [ -n "$branch" ]; then
      echo " $branch"
    fi
  fi
}
# Simple prompt with path in the window/pane title and caret for typing line
PS1=$'\uf0a9 '
PS1='\[\e]0;\w\a\]\w $(git_branch) $(get_ssh_info)\n\[\e[0;37m\] \[\e[0m\]'
