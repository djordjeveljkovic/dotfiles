# This function streams a playlist without downloading the files.
# It prioritizes the best audio available.
playlist-play() {
  if [ -z "$1" ]; then
    echo "Usage: playlist-play 'URL'"
    return 1
  fi
  yt-dlp --format 'ba' -o - "$1" | mpv --no-video --cache=yes -
}

# This function downloads and plays a single song.
# It organizes files by artist and title and includes the thumbnail.
song-play() {
  if [ -z "$1" ]; then
    echo "Usage: song-play 'URL'"
    return 1
  fi

  # Get song info from yt-dlp's JSON output
  SONG_INFO=$(yt-dlp --print-json "$1")
  ARTIST=$(echo "$SONG_INFO" | jq -r '.artist // "Unknown Artist"')
  TITLE=$(echo "$SONG_INFO" | jq -r '.title // "Untitled Song"')
  
  # 1. Clean the artist name: remove features, convert to lowercase, and replace spaces with underscores.
  CLEAN_ARTIST=$(echo "$ARTIST" | sed -E 's/(\s+(feat|ft|&|\/).*|\s*,.*)//I' | tr '[:upper:]' '[:lower:]' | sed 's/ /_/g')

  # Define the output template for the path using the cleaned artist name
  OUTPUT_TEMPLATE="$HOME/Music/$CLEAN_ARTIST/%(title)s.%(ext)s"
  
  # 2. Download the best audio and thumbnail. yt-dlp will create the directory for us.
  yt-dlp --extract-audio --audio-format mp3 --format 'ba/b' --write-thumbnail -o "$OUTPUT_TEMPLATE" "$1"

  # 3. Construct the FINAL_PATH manually to ensure it's always correct.
  # This avoids the "file not found" error.
  FINAL_PATH="$HOME/Music/$CLEAN_ARTIST/$TITLE.mp3"

  # 4. Check if the file was downloaded successfully and then play it.
  if [ -f "$FINAL_PATH" ]; then
    mpv --no-video "$FINAL_PATH"
  else
    echo "Error: Downloaded file not found at $FINAL_PATH"
  fi
}

# This function downloads a playlist into a specified folder and streams the audio as it downloads.
# Usage: playlist-dl-play 'My Playlist' 'https://www.youtube.com/playlist?list=...'
playlist-dl-play() {
  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Usage: playlist-dl-play 'playlist_name' 'URL'"
    return 1
  fi

  PLAYLIST_NAME=$(echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/ /_/g')
  PLAYLIST_URL="$2"
  PLAYLIST_DIR="$HOME/Music/$PLAYLIST_NAME"

  mkdir -p "$PLAYLIST_DIR"

  # Start downloading the playlist in the background.
  (
    yt-dlp --no-cache-dir --no-simulate-head --force-ipv4 \
      --extract-audio --audio-format mp3 --format 'ba/b' \
      --ignore-errors \
      -o "$PLAYLIST_DIR/%(title)s.%(ext)s" "$PLAYLIST_URL"

    # Rename the files after they are downloaded
    for file in "$PLAYLIST_DIR"/*; do
      if [ -f "$file" ]; then
        newname=$(basename "$file" | tr '[:upper:]' '[:lower:]' | sed 's/ /_/g')
        mv "$file" "$PLAYLIST_DIR/$newname"
      fi
    done
  ) &

  # Use mpv to monitor the directory and play new files as they appear.
  mpv --no-video --idle --loop=no --shuffle --watch-later-options="start=0" --on-playlist-change=soft \
    --playlist="$(find "$PLAYLIST_DIR" -type f -name "*.mp3" | sort)" \
    --watch-later-directory="$PLAYLIST_DIR" "$PLAYLIST_DIR"
}
