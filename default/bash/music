# This function streams a playlist without downloading the files.
# It prioritizes the best audio available.
playlist-play() {
  if [ -z "$1" ]; then
    echo "Usage: playlist-play 'URL'"
    return 1
  fi
  yt-dlp --format 'ba' -o - "$1" | mpv --no-video --cache=yes -
}

# This function downloads and plays a single song.
# It organizes files by artist and title and includes the thumbnail.
song-play() {
  if [ -z "$1" ]; then
    echo "Usage: song-play 'URL'"
    return 1
  fi

  # Get song info to clean up the artist name
  SONG_INFO=$(yt-dlp --print-json "$1")
  ARTIST=$(echo "$SONG_INFO" | jq -r '.artist // "Unknown Artist"')
  TITLE=$(echo "$SONG_INFO" | jq -r '.title // "Untitled Song"')

  # Remove featured artists and clean up the name
  # This pattern targets common "feat.", "ft.", "&", and "," separators
  CLEAN_ARTIST=$(echo "$ARTIST" | sed -E 's/(\s+(feat|ft|&|\/).*|\s+,.*)//I' | sed 's/ /_/g')

  # Define the output template for the path using the cleaned artist name
  OUTPUT_TEMPLATE="$HOME/Music/$CLEAN_ARTIST/%(title)s.%(ext)s"

  # Download the best audio and thumbnail
  yt-dlp --extract-audio --audio-format mp3 --format 'ba/b' --write-thumbnail -o "$OUTPUT_TEMPLATE" "$1"

  # Get the final path of the downloaded file
  FINAL_PATH=$(yt-dlp --get-filename --extract-audio --audio-format mp3 --format 'ba/b' -o "$OUTPUT_TEMPLATE" "$1")

  # Check if the file was downloaded successfully and then play it
  if [ -f "$FINAL_PATH" ]; then
    mpv --no-video "$FINAL_PATH"
  else
    echo "Error: Downloaded file not found at $FINAL_PATH"
  fi
}

# This function downloads a playlist and plays each song sequentially.
# It organizes files by playlist name and title, and includes thumbnails.
playlist-dl-play() {
  if [ -z "$1" ]; then
    echo "Usage: playlist-dl-play 'URL'"
    return 1
  fi

  # Get the playlist title for the directory name
  PLAYLIST_TITLE=$(yt-dlp --get-filename -o "%(playlist)s" "$1")

  # Create the target directory
  mkdir -p "$HOME/Music/$PLAYLIST_TITLE"

  # Define the output template for the playlist
  OUTPUT_TEMPLATE="$HOME/Music/$PLAYLIST_TITLE/%(title)s.%(ext)s"

  # Download the playlist, save the thumbnails, and then play each song
  yt-dlp --extract-audio --audio-format mp3 --format 'ba/b' --write-thumbnail --ignore-errors -o "$OUTPUT_TEMPLATE" "$1"

  # Play all the downloaded files in the directory
  find "$HOME/Music/$PLAYLIST_TITLE" -name "*.mp3" -print0 | xargs -0 mpv --no-video
}
