#!/bin/bash
set -e

TARGET="$HOME/.dots/default/hypr/monitors.conf"

get_connected_monitors() {
    xrandr --listmonitors | awk '/^\S/{print $2}'
}

get_monitor_resolutions() {
    monitor=$1
    xrandr | awk -v mon="$monitor" '
    $0 ~ "^" mon {
        getline
        while ($0 ~ /^[[:space:]]+[0-9]+x[0-9]+/) {
            print $1
            getline
        }
    }'
}

choice=$(printf "Display\nMirror\nExtend\nResolution\n" | \
  wofi --show dmenu \
       --prompt "Display Mode" \
       --width 100 --height 200 \
       --style ~/.dots/default/wofi/select.css)

case "$choice" in
  Display)
    profile="display"
    monitors=$(get_connected_monitors)

    selected_monitor=$(echo "$monitors" | \
      wofi --show dmenu --prompt "Pick Display" \
           --width 100 --height 155 \
           --style ~/.dots/default/wofi/select.css)

    resolutions=$(get_monitor_resolutions "$selected_monitor")
    resolution_choice=$(echo "$resolutions" | \
      wofi --show dmenu --prompt "Resolution for $selected_monitor" \
           --width 100 --height 155 \
           --style ~/.dots/default/wofi/select.css)

    {
      echo "# Only $selected_monitor active"
      echo "monitor = $selected_monitor, preferred, auto, 1, resolution $resolution_choice"
      for mon in $monitors; do
        if [ "$mon" != "$selected_monitor" ]; then
          echo "monitor = $mon, disable"
        fi
      done
    } > "$TARGET"
    ;;
  Mirror)
    profile="mirror"
    monitors=$(get_connected_monitors)

    first_monitor=$(echo "$monitors" | head -n 1)
    resolutions=$(get_monitor_resolutions "$first_monitor")
    resolution_choice=$(echo "$resolutions" | \
      wofi --show dmenu --prompt "Resolution (All)" \
           --width 100 --height 155 \
           --style ~/.dots/default/wofi/select.css)

    {
      echo "# Mirror mode"
      for mon in $monitors; do
        echo "monitor = $mon, preferred, auto, 1, resolution $resolution_choice"
      done
    } > "$TARGET"
    ;;
  Extend)
    profile="extend"
    monitors=$(get_connected_monitors)
    monitor_list=($monitors)

    echo "# Extend mode" > "$TARGET"

    base="${monitor_list[0]}"
    resolutions=$(get_monitor_resolutions "$base")
    base_res=$(echo "$resolutions" | \
      wofi --show dmenu --prompt "Resolution for $base" \
           --width 100 --height 155 \
           --style ~/.dots/default/wofi/select.css)

    echo "monitor = $base, preferred, auto, 1, resolution $base_res" >> "$TARGET"

    for i in "${!monitor_list[@]}"; do
      [ "$i" -eq 0 ] && continue
      mon="${monitor_list[$i]}"

      dir=$(printf "Right\nLeft\nUp\nDown" | \
        wofi --show dmenu --prompt "$mon placement (relative to $base)" \
             --width 100 --height 155 \
             --style ~/.dots/default/wofi/select.css)

      res=$(get_monitor_resolutions "$mon" | \
        wofi --show dmenu --prompt "Resolution for $mon" \
             --width 100 --height 155 \
             --style ~/.dots/default/wofi/select.css)

      echo "monitor = $mon, preferred, auto, 0, $dir, resolution $res" >> "$TARGET"
    done
    ;;
  Resolution)
    profile="resolution"
    monitors=$(get_connected_monitors)

    selected_monitor=$(echo "$monitors" | \
      wofi --show dmenu --prompt "Select Display" \
           --width 100 --height 155 \
           --style ~/.dots/default/wofi/select.css)

    resolutions=$(get_monitor_resolutions "$selected_monitor")
    resolution_choice=$(echo "$resolutions" | \
      wofi --show dmenu --prompt "Resolution for $selected_monitor" \
           --width 100 --height 155 \
           --style ~/.dots/default/wofi/select.css)

    # update only the line for the selected monitor
    tmp_conf=$(mktemp)
    updated=0
    while IFS= read -r line; do
      if [[ "$line" =~ ^monitor\ =\ $selected_monitor ]]; then
        if [[ "$line" =~ resolution\ [0-9]+x[0-9]+ ]]; then
          line=$(echo "$line" | sed -E "s/resolution [0-9]+x[0-9]+/resolution $resolution_choice/")
        else
          line="$line, resolution $resolution_choice"
        fi
        updated=1
      fi
      echo "$line" >> "$tmp_conf"
    done < "$TARGET"

    # If monitor wasn't previously in the config, add it
    if [ "$updated" -eq 0 ]; then
      echo "monitor = $selected_monitor, preferred, auto, 1, resolution $resolution_choice" >> "$tmp_conf"
    fi

    mv "$tmp_conf" "$TARGET"
    ;;
  *)
    exit 0
    ;;
esac

# Reload Hyprland config
if ! hyprctl reload; then
  notify-send "Display Switcher" "Failed to reload Hyprland config"
  exit 1
fi

sleep 0.5

# Move all workspaces to active monitor (Display mode only)
if [ "$profile" == "display" ]; then
  for ws in $(hyprctl workspaces -j | jq -r '.[].id'); do
    hyprctl dispatch moveworkspacetomonitor "$ws" "$selected_monitor"
  done
fi

notify-send "Display Switcher" "Applied profile: $profile"

