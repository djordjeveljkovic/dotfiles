#!/bin/bash

# 1. Set environment variables so the background service can find your screen
# This is crucial for notify-send to work from a service
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DISPLAY=:0

# 2. Send the notification. app-name=time so the mako [app-name=time]
# block (in ~/.dots/themes/catppuccin/mako.ini) can shrink the
# notification width — the time text is short, so a full-width
# notification is wasted space.
# %H:%M gives "14:30" format
TIME_NOW=$(date +'%H:%M')
notify-send -u low -a "time" -i clock "Time Update $TIME_NOW"
