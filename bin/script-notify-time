#!/bin/bash

# 1. Set environment variables so the background service can find your screen
# This is crucial for notify-send to work from a service
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DISPLAY=:0

# 2. Send the notification at the bottom-center (via the patched mako's
# x-dots-position hint). The same DBus bus as everything else; the
# patched mako routes the hint to a separate layer-shell surface.
# %H:%M gives "14:30" format
TIME_NOW=$(date +'%H:%M')
notify-send -u low \
    -h "string:x-dots-position:bottom-center" \
    -i clock \
    "Time Update $TIME_NOW"
