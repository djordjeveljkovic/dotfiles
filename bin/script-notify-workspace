#!/usr/bin/env bash
# Minimal workspace-change / window-move notification. Compositor-neutral.
# Usage: script-notify-workspace <switch|move> <workspace-number>
# Designed to be chained on the end of a bindsym line, e.g.:
#   bindsym $mod+3  workspace number 3, exec ~/.dots/bin/script-notify-workspace switch 3
#   bindsym $mod+Shift+3 move container to workspace number 3, exec ~/.dots/bin/script-notify-workspace move 3

# No `set -e`: if notify-send is missing or mako rejects, just exit 0.
shopt -s nullglob

action="${1:-}"
ws="${2:-}"

DOTS="${DOTS:-$HOME/.dots}"
# shellcheck disable=SC1091
. "$DOTS/lib/helpers.sh"
app_name="$(dots_compositor)"

case "$action" in
    switch)
        notify-send \
            -a "$app_name" \
            -t 1200 \
            -h "string:x-canonical-private-synchronous:workspace" \
            "→ $ws" "workspace" \
            2>/dev/null
        ;;
    move)
        notify-send \
            -a "$app_name" \
            -t 1200 \
            -h "string:x-canonical-private-synchronous:workspace" \
            "↪ $ws" "window moved" \
            2>/dev/null
        ;;
esac
exit 0