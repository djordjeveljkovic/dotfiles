#!/bin/bash

# Display sway keybindings defined in the dotfiles, via fuzzel.
# Parses `bindsym` lines from default/sway/bindings (and related include files).

SWAY_BINDINGS="$HOME/.dots/default/sway/bindings"

# bindsym lines look like:
#   bindsym $mod+b exec $browser
#   bindsym $mod+Shift+Left move left
# Strip comments, blank lines, and the literal "bindsym " prefix.
grep -h '^[[:space:]]*bindsym' "$SWAY_BINDINGS" \
  | sed -E 's/#.*//; /^[[:space:]]*$/d; s/^[[:space:]]*bindsym[[:space:]]+//' \
  | sort -u \
  | awk '{
      # First field = key combo, rest = action
      key = $1;
      $1 = "";
      action = $0;
      gsub(/^[ \t]+|[ \t]+$/, "", action);
      if (action != "") printf "%-28s -> %s\n", key, action;
    }' \
  | flock --nonblock /tmp/.fuzzel-keybinds.lock -c \
      "fuzzel -d -i --width 80 --height 70% -p 'Keybindings' --cache=/dev/null"
