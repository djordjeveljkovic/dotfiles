#!/usr/bin/env bash

alacritty --class "PHPPod" --title "Create PHP Pod" -e bash -ic '
    set -euo pipefail

    echo "📦 Create PHP Dev Pod"
    echo

    # Helper to check if port is in use
    check_port() {
        local port=$1
        ss -tuln | grep -q ":$port " && return 1 || return 0
    }

    # === Pod name ===
    while true; do
        read -rp "Pod name: " POD_NAME
        if [[ -z "$POD_NAME" ]]; then
            echo "❌ Pod name cannot be empty."
        elif podman pod exists "$POD_NAME"; then
            echo "❌ Pod name '$POD_NAME' already exists. Choose a different one."
        else
            break
        fi
    done

    # === Laravel project path ===
    while true; do
        read -e -rp "Laravel project path: " RAW_PATH
        if [[ -z "$RAW_PATH" ]]; then
            echo "❌ Project path cannot be empty."
            continue
        fi
        EVAL_PATH=$(eval echo "$RAW_PATH")
        if [[ ! -d "$EVAL_PATH" ]]; then
            echo "❌ Directory does not exist: $EVAL_PATH"
        else
            APP_PATH="$EVAL_PATH"
            break
        fi
    done

    # === Laravel port ===
    while true; do
        read -rp "Laravel port (default 8000): " APP_PORT
        APP_PORT=${APP_PORT:-8000}
        if [[ ! "$APP_PORT" =~ ^[0-9]+$ ]]; then
            echo "❌ Invalid port. Must be a number."
        elif ! check_port "$APP_PORT"; then
            echo "❌ Port $APP_PORT is already in use."
        else
            break
        fi
    done

    # === MySQL port ===
    while true; do
        read -rp "MySQL port (default 3306): " MYSQL_PORT
        MYSQL_PORT=${MYSQL_PORT:-3306}
        if [[ ! "$MYSQL_PORT" =~ ^[0-9]+$ ]]; then
            echo "❌ Invalid port. Must be a number."
        elif ! check_port "$MYSQL_PORT"; then
            echo "❌ Port $MYSQL_PORT is already in use."
        else
            break
        fi
    done

    # === phpMyAdmin port ===
    while true; do
        read -rp "phpMyAdmin port (default 8080): " PMA_PORT
        PMA_PORT=${PMA_PORT:-8080}
        if [[ ! "$PMA_PORT" =~ ^[0-9]+$ ]]; then
            echo "❌ Invalid port. Must be a number."
        elif ! check_port "$PMA_PORT"; then
            echo "❌ Port $PMA_PORT is already in use."
        else
            break
        fi
    done

    # === PHP version ===
    while true; do
        read -rp "PHP version (default 8.2): " PHP_VERSION
        PHP_VERSION=${PHP_VERSION:-8.2}
        if [[ ! "$PHP_VERSION" =~ ^8\.[0-9]+$ ]]; then
            echo "❌ PHP version must match 8.x (e.g., 8.2)."
        else
            break
        fi
    done

    echo
    echo "✅ Creating pod '$POD_NAME'..."
    if ~/.dots/bin/script-create-php-pod \
      -name "$POD_NAME" \
      -app "$APP_PATH" \
      -app-port "$APP_PORT" \
      -mysql-port "$MYSQL_PORT" \
      -pma-port "$PMA_PORT" \
      -php-version "$PHP_VERSION" \
      -artisan; then
        echo
        echo "✅ Pod successfully created and running!"
    else
        echo
        echo "❌ An error occurred during pod setup."
    fi

    echo
    echo "📄 Inspect manually or run: podman pod logs $POD_NAME"
    echo "➡️ Type 'exit' or press Ctrl+D to close this shell."
    exec bash
'

