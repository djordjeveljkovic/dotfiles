#!/usr/bin/env bash
# ~/.dots/bin/dots-system-notify
#
# notify-send wrapper that tags the notification with the
# x-dots-position D-Bus hint so the patched mako (see
# ~/.local/src/mako branch position-hint) routes it to the
# bottom-center layer-shell surface instead of the default
# top-right one.
#
# Used by system-info scripts (volume / brightness / mic / media
# / keyboard layout) for the system OSDs. Plain notify-send (no
# wrapper) still works for app notifications and goes top-right
# because the x-dots-position hint is omitted.
#
# On an unpatched mako (e.g. system /usr/bin/mako on a fresh
# install before the custom binary is built) the hint is silently
# ignored and the notification lands at the global default anchor
# (top-right). That is a graceful fallback — no crash, no
# misrouting — just no bottom-center UX.
#
# Usage is identical to notify-send:
#   dots-system-notify -a audio "Volume 60%" ""
#   dots-system-notify -u low -t 1500 "Quick ping"

set -euo pipefail

# Prepend the position hint, keep every other argument the caller
# passed. The hint must come before the summary because notify-send
# parses positional args from left to right.
exec notify-send -h "string:x-dots-position:bottom-center" "$@"