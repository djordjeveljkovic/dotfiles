#!/bin/bash

# Toggle night light via wlsunset (lighter than gammastep: tiny C daemon,
# wlr-gamma-control only, no geolocation/Python deps).
# -T 4000  -> night temperature in Kelvin
# -g 0.5   -> gamma multiplier (0.5 = 50% dim)

if pgrep -x wlsunset >/dev/null 2>&1; then
    pkill wlsunset
    notify-send "Night light" "Off"
else
    wlsunset -T 4000 -g 0.5 &
    notify-send "Night light" "On (4000K, 50%)"
fi
