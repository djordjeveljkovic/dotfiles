#!/bin/bash

MON_DIR="$HOME/.dots/default/hypr/monitors"
MASTER_CONF="$HOME/.dots/default/hypr/monitors.conf"

mkdir -p "$MON_DIR"

monitors=$(hyprctl monitors all -j | jq -r '.[] | .name')

for mon in $monitors; do
    if [ ! -f "$MON_DIR/$mon.conf" ]; then
        echo "monitor=$mon,preferred,auto,1" > "$MON_DIR/$mon.conf"
    fi
done

echo "# Autogenerated by parse_monitors.sh" > "$MASTER_CONF"
for file in "$MON_DIR"/*.conf; do
    [ -e "$file" ] && echo "source = $file" >> "$MASTER_CONF"
done
