#!/usr/bin/env bash
# Pick a wallpaper with yazi and apply it compositor-neutrally.
#
# Sway: `swaymsg output * bg <path> fill` (no extra daemon needed).
# Hyprland: hyprpaper, configured via the special-category syntax
#   (changed in hyprpaper 0.8.x — `wallpaper = MONITOR,PATH` no longer works):
#
#       wallpaper {
#           monitor = eDP-1
#           path    = /home/user/Pictures/wall.jpg
#           fit_mode = cover
#       }
#
#   `preload =` is also gone; `path` both preloads the image into
#   hyprpaper's memory and assigns it to the monitor. Live updates via
#   hyprctl hyprpaper preload/wallpaper are deprecated too, so the script
#   rewrites the config and restarts hyprpaper each time.
#
# Compositor is detected via dots_compositor() (lib/helpers.sh):
# env var DOTS_COMPOSITOR, then ~/.config/dots/compositor, then
# pgrep for Hyprland / sway.

set -euo pipefail
DOTS="${DOTS:-$HOME/.dots}"
# shellcheck disable=SC1091
. "$DOTS/lib/helpers.sh"

WALLDIR="$HOME/Pictures/walls"
TMPFILE="/tmp/yazi_selected_wallpaper"

yazi "$WALLDIR" --chooser-file "$TMPFILE"

if [[ ! -s "$TMPFILE" ]]; then
    notify-send "No wallpaper selected."
    exit 0
fi

WALL=$(cat "$TMPFILE")

if [[ ! -f "$WALL" ]]; then
    notify-send "Invalid file." "$WALL"
    exit 1
fi

apply_wall_sway() {
    swaymsg "output * bg '$WALL' fill"
}

apply_wall_hyprland() {
    local conf="$HOME/.config/hypr/hyprpaper.conf"

    # Discover monitor names from Hyprland — only `enabled: false`-skipped
    # outputs need wallpaper entries; disabled outputs are skipped.
    local monitors
    monitors=$(hyprctl monitors -j | jq -r '.[] | select(.disabled == false) | .name')

    # Write a fresh config in the special-category syntax. Including all
    # currently-connected monitors means a docked-laptop user gets the new
    # wallpaper on every output at once. `fit_mode = cover` is the
    # hyprpaper default; explicit here for clarity.
    mkdir -p "$(dirname "$conf")"
    {
        echo "# Regenerated by script-wallpaper on $(date -Iseconds)"
        echo "ipc = on"
        echo
        for mon in $monitors; do
            cat <<MON
wallpaper {
    monitor = $mon
    path = $WALL
    fit_mode = cover
}

MON
        done
    } > "$conf"

    # hyprpaper doesn't reload its own config (no SIGHUP handler); restart
    # cleanly. nohup+disown so the new process survives the script exit
    # (set -e + huponexit would SIGHUP a `setsid ... &`).
    pkill -x hyprpaper 2>/dev/null || true
    sleep 0.2
    nohup hyprpaper >/dev/null 2>&1 &
    disown || true
}

case "$(dots_compositor)" in
    sway)     apply_wall_sway ;;
    hyprland) apply_wall_hyprland ;;
    *)
        notify-send "Unknown compositor" \
            "dots_compositor returned '$(dots_compositor)'; cannot set wallpaper."
        exit 1
        ;;
esac

# Persist as the default background so the next boot keeps it.
mkdir -p "$HOME/.dots/assets"
cp "$WALL" "$HOME/.dots/assets/background"

notify-send "Wallpaper set" "$(basename "$WALL")"
