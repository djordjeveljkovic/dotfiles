#!/usr/bin/env bash
set -euo pipefail

# Default values
POD_NAME="dev-pod"
MYSQL_PORT=3306
PMA_PORT=8080
APP_PORT=8000
MYSQL_ROOT_PW="StrongRootPW"
MYSQL_USER="usr"
MYSQL_PASSWORD="usr"
MYSQL_DATABASE="app"
MYSQL_VERSION="8.0"
PMA_VERSION="latest"
PHP_VERSION="8.2"
APP_PATH="$HOME/projects/myapp"
USE_ARTISAN=true

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    -name) POD_NAME="$2"; shift 2 ;;
    -mysql-port) MYSQL_PORT="$2"; shift 2 ;;
    -pma-port) PMA_PORT="$2"; shift 2 ;;
    -app-port) APP_PORT="$2"; shift 2 ;;
    -mysql-version) MYSQL_VERSION="$2"; shift 2 ;;
    -pma-version) PMA_VERSION="$2"; shift 2 ;;
    -php-version) PHP_VERSION="$2"; shift 2 ;;
    -app) APP_PATH="$2"; shift 2 ;;
    -artisan) USE_ARTISAN=true; shift ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: $0 [-name POD_NAME] [-mysql-port PORT] [-pma-port PORT] [-app-port PORT] [-mysql-version VERSION] [-pma-version VERSION] [-php-version VERSION] [-app PATH] [-artisan]"
      exit 1
      ;;
  esac
done

MYSQL_NAME="mysql-${POD_NAME}"
PMA_NAME="phpmyadmin-${POD_NAME}"
PHP_NAME="php${PHP_VERSION//./}"

# Recreate pod
if podman pod exists "${POD_NAME}"; then
  podman pod stop "${POD_NAME}" || true
  podman pod rm "${POD_NAME}" || true
fi

podman pod create --name "${POD_NAME}" \
  -p ${MYSQL_PORT}:3306 -p ${PMA_PORT}:80 -p ${APP_PORT}:8000

# Start MySQL
podman run -d --pod "${POD_NAME}" --name "${MYSQL_NAME}" \
  -e MYSQL_ROOT_PASSWORD="${MYSQL_ROOT_PW}" \
  -e MYSQL_DATABASE="${MYSQL_DATABASE}" \
  -e MYSQL_USER="${MYSQL_USER}" \
  -e MYSQL_PASSWORD="${MYSQL_PASSWORD}" \
  docker.io/library/mysql:${MYSQL_VERSION}

# Start phpMyAdmin
podman run -d --pod "${POD_NAME}" --name "${PMA_NAME}" \
  -e PMA_HOST="127.0.0.1" \
  -e PMA_USER="root" \
  -e PMA_PASSWORD="${MYSQL_ROOT_PW}" \
  docker.io/phpmyadmin/phpmyadmin:${PMA_VERSION}

# Start PHP container
podman run -dit --pod "${POD_NAME}" --name "${PHP_NAME}" \
  -v "${APP_PATH}:/app:Z" \
  -w /app \
  docker.io/library/php:${PHP_VERSION}-cli bash

# Run Laravel server
if [ "$USE_ARTISAN" = true ]; then
  podman exec "${PHP_NAME}" sh -c "
    apt update && apt install -y curl unzip git zip &&
    curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer &&
    composer install &&
    php artisan serve --host=0.0.0.0 --port=${APP_PORT}
  "
else
  echo "✅ PHP ${PHP_VERSION} CLI container running inside pod '${POD_NAME}'"
  echo "Run commands using: podman exec -it ${PHP_NAME} bash"
fi

echo "✅ MySQL ${MYSQL_VERSION} running on localhost:${MYSQL_PORT}"
echo "✅ phpMyAdmin at http://localhost:${PMA_PORT}/"
echo "✅ Laravel app (if served) at http://localhost:${APP_PORT}/"
